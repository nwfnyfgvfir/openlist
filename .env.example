# GitHub username or org that owns the GHCR package (must be lowercase)
GHCR_OWNER=your-github-username

# Image tag (latest | upstream-v4.2.3 | fe-v4.2.3 | sha-xxxxxx)
OPENLIST_TAG=latest

# Host port
OPENLIST_PORT=5244

# Data directory on host (relative to this compose file or absolute path)
OPENLIST_DATA=./data

UMASK=022
